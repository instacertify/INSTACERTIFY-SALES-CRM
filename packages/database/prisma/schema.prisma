// Instacertify CRM — project-centric modular monolith schema
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & org ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SALES_OPS") // ADMIN | SALES_OPS | DELIVERY | FINANCE
  active       Boolean  @default(true)
  skills       String   @default("")
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee             EmployeeProfile?
  leadsCreated         Lead[]              @relation("LeadCreator")
  leadsAssigned        Lead[]              @relation("LeadAssignee")
  opportunitiesOwned   Opportunity[]       @relation("OpportunityOwner")
  quotationsCreated    Quotation[]         @relation("QuotationCreator")
  commercialProjects   Project[]           @relation("ProjectCommercialOwner")
  deliveryProjects     Project[]           @relation("ProjectDeliveryOwner")
  tasksAssigned        ProjectTask[]       @relation("TaskAssignee")
  projectRemarks       ProjectRemark[]
  notifications        Notification[]
  documentsUploaded    Document[]          @relation("DocumentUploader")
  invoicesCreated      Invoice[]           @relation("InvoiceCreator")
  workLibraryEntries   WorkLibraryEntry[]  @relation("WorkLibraryAuthor")
  documentRequests     DocumentRequest[]   @relation("DocRequestCreator")
  testRequestsCreated  TestRequestForm[]   @relation("TestRequestCreator")
}

model EmployeeProfile {
  id         String   @id @default(cuid())
  department String?
  title      String?
  managerId  String?
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── CRM core: Lead → Customer → Opportunity → Quotation → Project ─

model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Customer {
  id             String    @id @default(cuid())
  company        String
  legalName      String?
  email          String    @unique
  phone          String?
  country        String    @default("India")
  state          String?
  city           String?
  address        String?
  gstin          String?
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE
  notes          String?
  lifetimeValue  Float     @default(0)
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contacts          Contact[]
  leads             Lead[]
  opportunities     Opportunity[]
  quotations        Quotation[]
  projects          Project[]
  invoices          Invoice[]
  documents         Document[]
  documentRequests  DocumentRequest[]
  testRequestForms  TestRequestForm[]
  workLibrary       WorkLibraryEntry[]
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Lead {
  id            String    @id @default(cuid())
  customerName  String
  company       String
  companySize   String    @default("SMALL") // MICRO | SMALL | MEDIUM | LARGE
  email         String
  phone         String
  country       String
  state         String?
  product       String?
  serviceName   String?
  expectedValue Float     @default(0)
  expectedClose DateTime?
  status        String    @default("NEW")
  // NEW | CONTACTED | QUALIFIED | QUOTATION | NEGOTIATION | WON | LOST
  followUpAt    DateTime?
  lastContactAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leadSourceId String
  leadSource   LeadSource @relation(fields: [leadSourceId], references: [id])
  createdById  String
  createdBy    User       @relation("LeadCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])

  opportunities Opportunity[]
  quotations    Quotation[]
  projects      Project[]

  @@index([status])
  @@index([assignedToId])
  @@index([email])
}

model Opportunity {
  id            String    @id @default(cuid())
  title         String
  stage         String    @default("DISCOVERY")
  // DISCOVERY | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  amount        Float     @default(0)
  probability   Int       @default(20)
  expectedClose DateTime?
  serviceName   String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  ownerId    String?
  owner      User?    @relation("OpportunityOwner", fields: [ownerId], references: [id])

  quotations Quotation[]

  @@index([stage])
  @@index([customerId])
}

model Quotation {
  id                   String    @id @default(cuid())
  quoteNumber          String    @unique
  publicToken          String    @unique
  status               String    @default("DRAFT")
  // DRAFT | SHARED | REVISION_REQUESTED | ACCEPTED | SUPERSEDED | REJECTED
  customerName         String
  company              String
  email                String
  phone                String
  country              String
  state                String?
  serviceName          String
  description          String
  validityDate         DateTime
  consultingPrice      Float     @default(0)
  testingPrice         Float     @default(0)
  otherCommercials     Float     @default(0)
  otherCommercialsNote String?
  governmentFees       Float     @default(0)
  bodyHtml             String    @default("")
  bankSnapshot         String    @default("")
  customerRemark       String?
  revisionMessage      String?
  sharedAt             DateTime?
  acceptedAt           DateTime?
  testingOptedAt       DateTime?
  revisionCount        Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id])
  createdById    String
  createdBy      User          @relation("QuotationCreator", fields: [createdById], references: [id])

  projects           Project[]
  invoices           Invoice[]
  lineItems          QuotationLineItem[]
  events             QuotationEvent[]
  documentRequests   DocumentRequest[]
  testRequestForms   TestRequestForm[]

  @@index([status])
  @@index([customerId])
}

// ─── Project control tower (core) ─────────────────────────────────

model Project {
  id                 String    @id @default(cuid())
  projectNumber      String    @unique
  title              String
  status             String    @default("NOT_STARTED")
  // NOT_STARTED | QUOTED | ACCEPTED | DOCUMENTS_PENDING | DOCUMENTS_COMPLETE
  // | SAMPLE_PENDING | TESTING | APPLICATION | AUTHORITY_PENDING
  // | CLIENT_ACTION | CERTIFICATION | DELIVERY | COMPLETED | CLOSED | LOST
  serviceName        String?
  serviceType        String? // BIS | WPC | EPR | LMPC | CDSCO | TESTING | OTHER
  projectValue       Float     @default(0)
  consultingFees     Float     @default(0)
  governmentFees     Float     @default(0)
  testingFees        Float     @default(0)
  paymentStatus      String    @default("PENDING") // PENDING | PARTIAL | PAID | OVERDUE
  startDate          DateTime?
  expectedCompletion DateTime?
  renewalDate        DateTime?
  waitingFor         String? // Client | Lab | Government | Payment | Sample | Internal | Other
  waitingExpectedOn  DateTime?
  waitingNote        String?
  scopeSummary       String?
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // denormalized contact snapshot
  customerName String
  company      String
  email        String
  phone        String?
  country      String?
  state        String?

  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?      @relation(fields: [leadId], references: [id])
  quotationId String?
  quotation  Quotation? @relation(fields: [quotationId], references: [id])

  commercialOwnerId String?
  commercialOwner   User?   @relation("ProjectCommercialOwner", fields: [commercialOwnerId], references: [id])
  deliveryOwnerId   String?
  deliveryOwner     User?   @relation("ProjectDeliveryOwner", fields: [deliveryOwnerId], references: [id])

  products           ProjectProduct[]
  manufacturers      Manufacturer[]
  applicants         Applicant[]
  standards          ServiceStandard[]
  tasks              ProjectTask[]
  remarks            ProjectRemark[]
  documents          Document[]
  testingOrders      TestingOrder[]
  sampleShipments    SampleShipment[]
  certifications     CertificationRecord[]
  invoices           Invoice[]
  authorityQueries   AuthorityQuery[]
  documentRequests   DocumentRequest[]
  testRequestForms   TestRequestForm[]
  workLibrary        WorkLibraryEntry[]

  @@index([status])
  @@index([customerId])
  @@index([commercialOwnerId])
  @@index([deliveryOwnerId])
  @@index([waitingFor])
}

model ProjectProduct {
  id           String   @id @default(cuid())
  name         String
  modelNumber  String?
  brand        String?
  hsCode       String?
  description  String?
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String
  country   String?
  address   String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Applicant {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("COMPANY") // COMPANY | INDIVIDUAL | AUTHORIZED_INDIAN_REP
  email     String?
  phone     String?
  address   String?
  gstin     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ServiceStandard {
  id          String   @id @default(cuid())
  code        String // e.g. IS 13252
  name        String
  authority   String? // BIS | WPC | CPCB | CDSCO
  description String?
  createdAt   DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTask {
  id                String    @id @default(cuid())
  title             String
  status            String    @default("TODO") // TODO | IN_PROGRESS | WAITING | COMPLETED
  waitingFor        String?
  waitingExpectedOn DateTime?
  waitingNote       String?
  dueDate           DateTime?
  sequence          Int       @default(10)
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
}

model ProjectRemark {
  id        String   @id @default(cuid())
  stage     String   @default("Other")
  remark    String
  createdAt DateTime @default(now())

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  @@index([projectId])
}

model AuthorityQuery {
  id          String    @id @default(cuid())
  reference   String?
  question    String
  response    String?
  status      String    @default("OPEN") // OPEN | ANSWERED | CLOSED
  dueDate     DateTime?
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─── Testing, labs, samples ───────────────────────────────────────

model PartnerLab {
  id            String   @id @default(cuid())
  name          String
  country       String?
  city          String?
  email         String?
  phone         String?
  nabl          Boolean  @default(false)
  /// Searchable lab accreditation / test scope text
  scope         String   @default("")
  accreditation String?
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItems    TestingCatalogItem[]
  testingOrders   TestingOrder[]
  sampleShipments SampleShipment[]
}

/// Master catalog for selling testing — purchase vs sell price + lab scope
model TestingCatalogItem {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("GENERAL") // EMI | SAFETY | CHEMICAL | RF | ENVIRONMENTAL | OTHER
  scope         String   @default("") // searchable scope keywords / standards
  standardCode  String?
  purchasePrice Float    @default(0) // lab cost (internal)
  salesPrice    Float    @default(0) // price employee should sell at
  currency      String   @default("INR")
  turnaroundDays Int     @default(15)
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partnerLabId String?
  partnerLab   PartnerLab? @relation(fields: [partnerLabId], references: [id])

  lineItems      QuotationLineItem[]
  testingOrders  TestingOrder[]

  @@index([name])
  @@index([category])
  @@index([partnerLabId])
}

model TestingOrder {
  id            String    @id @default(cuid())
  testName      String
  status        String    @default("PLANNED")
  // PLANNED | SAMPLE_REQUIRED | IN_PROGRESS | COMPLETED | FAILED | CANCELLED
  purchasePrice Float     @default(0)
  salesPrice    Float     @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  reportRef     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerLabId String?
  partnerLab   PartnerLab? @relation(fields: [partnerLabId], references: [id])
  catalogItemId String?
  catalogItem   TestingCatalogItem? @relation(fields: [catalogItemId], references: [id])
  testRequestForm TestRequestForm?

  @@index([projectId])
  @@index([status])
}

model SampleShipment {
  id             String    @id @default(cuid())
  trackingNumber String?
  carrier        String?
  status         String    @default("PENDING")
  // PENDING | DISPATCHED | IN_TRANSIT | RECEIVED | RETURNED | LOST
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerLabId String?
  partnerLab   PartnerLab? @relation(fields: [partnerLabId], references: [id])

  @@index([projectId])
  @@index([status])
}

// ─── Documents, certification, finance ────────────────────────────

model Document {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("GENERAL")
  // GENERAL | MANUFACTURER | APPLICANT | TEST_REPORT | APPLICATION | CERTIFICATE | INVOICE | OTHER
  originalName String
  storedName   String
  mimeType     String?
  size         Int      @default(0)
  storageKey   String? // S3 object key when using object storage
  status       String   @default("UPLOADED") // REQUESTED | UPLOADED | VERIFIED | REJECTED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  uploadedById String?
  uploadedBy   User?     @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([customerId])
}

model CertificationRecord {
  id              String    @id @default(cuid())
  certificateNo   String?
  authority       String?
  status          String    @default("PENDING")
  // PENDING | APPLIED | QUERY | GRANTED | REJECTED | EXPIRED | RENEWED
  issuedAt        DateTime?
  expiresAt       DateTime?
  renewalDate     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  status        String    @default("DRAFT") // DRAFT | SENT | PARTIAL | PAID | VOID
  currency      String    @default("INR")
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  total         Float     @default(0)
  dueDate       DateTime?
  issuedAt      DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  createdById String?
  createdBy   User?      @relation("InvoiceCreator", fields: [createdById], references: [id])

  payments Payment[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

model Payment {
  id            String   @id @default(cuid())
  amount        Float
  method        String   @default("BANK_TRANSFER") // BANK_TRANSFER | UPI | CHEQUE | CARD | OTHER
  reference     String?
  receivedAt    DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  link      String?
  channel   String   @default("IN_APP") // IN_APP | EMAIL | WHATSAPP
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── Sales packaging: quote lines + journey events ────────────────

model QuotationLineItem {
  id            String   @id @default(cuid())
  kind          String   @default("CONSULTING") // CONSULTING | TESTING | GOVERNMENT | OTHER
  title         String
  description   String?
  quantity      Int      @default(1)
  unitPrice     Float    @default(0) // sell price shown to customer
  purchasePrice Float    @default(0) // internal cost (testing)
  amount        Float    @default(0)
  createdAt     DateTime @default(now())

  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   TestingCatalogItem? @relation(fields: [catalogItemId], references: [id])

  @@index([quotationId])
}

model QuotationEvent {
  id        String   @id @default(cuid())
  event     String
  // CREATED | SHARED | REVISION_REQUESTED | REVISED | TESTING_OPTED | ACCEPTED | REJECTED
  note      String?
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([event])
}

/// Certification consulting / bundled service offerings
model ServiceOffering {
  id          String   @id @default(cuid())
  name        String   @unique
  serviceType String   @default("CONSULTING") // CONSULTING | TESTING | BUNDLE
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklistItems   ChecklistTemplateItem[]
  documentRequests DocumentRequest[]
}

model ChecklistTemplateItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  required    Boolean @default(true)
  sequence    Int     @default(10)

  serviceOfferingId String
  serviceOffering   ServiceOffering @relation(fields: [serviceOfferingId], references: [id], onDelete: Cascade)

  @@index([serviceOfferingId])
}

/// Portal document checklist shared with customer
model DocumentRequest {
  id            String   @id @default(cuid())
  publicToken   String   @unique
  status        String   @default("SHARED") // SHARED | PARTIAL | COMPLETE | CLOSED
  title         String
  teamRemark    String?
  customerNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceOfferingId String?
  serviceOffering   ServiceOffering? @relation(fields: [serviceOfferingId], references: [id])
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id])
  quotationId       String?
  quotation         Quotation? @relation(fields: [quotationId], references: [id])
  createdById       String?
  createdBy         User? @relation("DocRequestCreator", fields: [createdById], references: [id])

  items DocumentRequestItem[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

model DocumentRequestItem {
  id           String    @id @default(cuid())
  name         String
  description  String?
  required     Boolean   @default(true)
  status       String    @default("PENDING") // PENDING | UPLOADED | VERIFIED | REJECTED
  customerNote String?
  fileName     String?
  storedName   String?
  uploadedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requestId String
  request   DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// Customer-filled test request — employee downloads & shares with lab
model TestRequestForm {
  id              String    @id @default(cuid())
  publicToken     String    @unique
  status          String    @default("SHARED") // SHARED | SUBMITTED | DOWNLOADED | SENT_TO_LAB
  productName     String?
  modelNumber     String?
  brand           String?
  manufacturer    String?
  sampleQuantity  String?
  standards       String?
  testScope       String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  additionalNotes String?
  /// Full form payload as JSON for extensibility
  formJson        String    @default("{}")
  submittedAt     DateTime?
  downloadedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  quotationId   String?
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  testingOrderId String?  @unique
  testingOrder  TestingOrder? @relation(fields: [testingOrderId], references: [id])
  createdById   String?
  createdBy     User? @relation("TestRequestCreator", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

/// Interactive work library — map work done for a client
model WorkLibraryEntry {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("GENERAL")
  // QUOTE | DOCUMENT | TESTING | APPLICATION | CERTIFICATION | PAYMENT | COMMUNICATION | OTHER
  summary     String
  status      String   @default("DONE") // PLANNED | IN_PROGRESS | DONE | BLOCKED
  effortHours Float    @default(0)
  valueAmount Float    @default(0)
  happenedAt  DateTime @default(now())
  linkUrl     String?
  tags        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  createdById String?
  createdBy   User? @relation("WorkLibraryAuthor", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([projectId])
  @@index([category])
  @@index([happenedAt])
}
