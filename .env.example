# ── Database (Hostinger VPS PostgreSQL — no Docker) ─────────────
DATABASE_URL=postgresql://instacertify:ChangeThisPassword@127.0.0.1:5432/instacertify?schema=public

# ── API ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=https://crm.instacertify.in
ENABLE_REDIS=false
# Only if ENABLE_REDIS=true:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
FILE_STORAGE=local

# ── Web ─────────────────────────────────────────────────────────
# Use same domain via Nginx /api proxy on Hostinger:
NEXT_PUBLIC_API_URL=https://crm.instacertify.in/api/v1
NEXTAUTH_URL=https://crm.instacertify.in
NEXTAUTH_SECRET=change-me-web-secret
APP_URL=https://crm.instacertify.in
DOMAIN=crm.instacertify.in
