# ── Core ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://instacertify:ChangeThisPassword@127.0.0.1:5432/instacertify?schema=public
JWT_SECRET=change-me-to-a-long-random-string

# IMPORTANT (Hostinger Node / Web Apps):
#   Do NOT set PORT in hPanel — Hostinger injects the public port.
#   Nest listens on API_PORT internally; server.js proxies /api → Nest.
API_PORT=4000
HOST=0.0.0.0

CORS_ORIGIN=https://crm.instacertify.in,http://localhost:3000
APP_URL=https://crm.instacertify.in
DOMAIN=crm.instacertify.in

# ── Web ───────────────────────────────────────────────────────────
# Prefer same-origin so Hostinger only needs one public port:
NEXT_PUBLIC_API_URL=/api/v1
NEXTAUTH_URL=https://crm.instacertify.in
NEXTAUTH_SECRET=change-me-web-secret

# ── Redis / BullMQ (optional — leave false on Hostinger Web Apps) ─
ENABLE_REDIS=false
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── File storage: local | s3 ──────────────────────────────────────
FILE_STORAGE=local
UPLOAD_DIR=./uploads
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=ap-south-1
# S3_BUCKET=instacertify-crm
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# ── Notifications (optional) ──────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# ── Monitoring / analytics (optional) ─────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
