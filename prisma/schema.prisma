generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SALES_OPS") // ADMIN | SALES_OPS
  active       Boolean  @default(true)
  skills       String   @default("") // comma-separated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadsCreated         Lead[]              @relation("LeadCreator")
  leadsAssigned        Lead[]              @relation("LeadAssignee")
  leadLogs             LeadLog[]
  quotesCreated        Quote[]             @relation("QuoteCreator")
  templatesCreated     QuoteTemplate[]
  notifications        Notification[]
  documentRequests     DocumentRequest[]   @relation("DocRequestCreator")
  reportsUploaded      Report[]            @relation("ReportUploader")
  commercialProjects   Project[]           @relation("ProjectCommercialOwner")
  deliveryProjects     Project[]           @relation("ProjectDeliveryOwner")
  tasksAssigned        ProjectTask[]       @relation("TaskAssignee")
  projectRemarks       ProjectRemark[]
}

model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Customer {
  id            String    @id @default(cuid())
  company       String
  customerName  String
  email         String    @unique
  phone         String?
  country       String    @default("India")
  state         String?
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  notes         String?
  lifetimeValue Float     @default(0)
  lastActivityAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leads    Lead[]
  projects Project[]
  quotes   Quote[]
}

model Lead {
  id            String    @id @default(cuid())
  customerName  String
  company       String
  companySize   String // MICRO | SMALL | MEDIUM | LARGE
  email         String
  phone         String
  country       String
  state         String?
  product       String?
  serviceName   String?
  expectedValue Float     @default(0)
  expectedClose DateTime?
  status        String    @default("NEW")
  // NEW | CONTACTED | QUALIFIED | QUOTATION | NEGOTIATION | WON | LOST
  followUpAt    DateTime?
  lastContactAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leadSourceId String
  leadSource   LeadSource @relation(fields: [leadSourceId], references: [id])
  createdById  String
  createdBy    User       @relation("LeadCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])

  logs     LeadLog[]
  quotes   Quote[]
  projects Project[]
}

model LeadLog {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  leadId      String
  lead        Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

model Project {
  id                 String    @id @default(cuid())
  projectNumber      String    @unique
  title              String
  status             String    @default("NOT_STARTED")
  // NOT_STARTED | QUOTED | ACCEPTED | DOCUMENTS_PENDING | DOCUMENTS_COMPLETE | TESTING | APPLICATION | AUTHORITY_PENDING | CLIENT_ACTION | COMPLETED | CLOSED | LOST
  serviceName        String?
  projectValue       Float     @default(0)
  startDate          DateTime?
  expectedCompletion DateTime?
  waitingFor         String? // Client | Lab | Government | Payment | Sample | Internal | Other
  waitingExpectedOn  DateTime?
  waitingNote        String?
  scopeSummary       String?
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])

  commercialOwnerId String?
  commercialOwner   User?   @relation("ProjectCommercialOwner", fields: [commercialOwnerId], references: [id])
  deliveryOwnerId   String?
  deliveryOwner     User?   @relation("ProjectDeliveryOwner", fields: [deliveryOwnerId], references: [id])

  customerName String
  company      String
  email        String
  phone        String?
  country      String?
  state        String?

  tasks   ProjectTask[]
  remarks ProjectRemark[]
}

model ProjectTask {
  id                String    @id @default(cuid())
  title             String
  status            String    @default("TODO") // TODO | IN_PROGRESS | WAITING | COMPLETED
  waitingFor        String?
  waitingExpectedOn DateTime?
  waitingNote       String?
  dueDate           DateTime?
  sequence          Int       @default(10)
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
}

model ProjectRemark {
  id        String   @id @default(cuid())
  stage     String   @default("Other")
  remark    String
  createdAt DateTime @default(now())

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  documents DocumentLibraryItem[]
  requests  DocumentRequest[]
}

model DocumentLibraryItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  required    Boolean @default(true)
  active      Boolean @default(true)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  uploads CustomerDocumentUpload[]
}

model BankDetail {
  id            String   @id @default(cuid())
  accountName   String
  bankName      String
  accountNumber String
  ifsc          String
  branch        String?
  upi           String?
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  templates QuoteTemplate[]
  quotes    Quote[]
}

model QuoteTemplate {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  bodyHtml             String   @default("")
  validityDays         Int      @default(30)
  consultingPrice      Float    @default(0)
  testingPrice         Float    @default(0)
  otherCommercials     Float    @default(0)
  otherCommercialsNote String?
  serviceNote          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bankDetailId String?
  bankDetail   BankDetail? @relation(fields: [bankDetailId], references: [id])
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])

  quotes Quote[]
}

model Quote {
  id          String @id @default(cuid())
  quoteNumber String @unique
  publicToken String @unique
  status      String @default("DRAFT")
  // DRAFT | SHARED | REVISION_REQUESTED | ACCEPTED | SUPERSEDED

  customerName String
  company      String
  email        String
  phone        String
  country      String
  state        String?

  serviceName          String
  description          String
  validityDate         DateTime
  consultingPrice      Float    @default(0)
  testingPrice         Float    @default(0)
  otherCommercials     Float    @default(0)
  otherCommercialsNote String?
  testingItemsJson     String   @default("[]")
  bodyHtml             String   @default("")
  bankSnapshot         String   @default("")
  customerRemark       String?
  revisionMessage      String?
  sharedAt             DateTime?
  acceptedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  templateId String?
  template   QuoteTemplate? @relation(fields: [templateId], references: [id])

  bankDetailId String?
  bankDetail   BankDetail? @relation(fields: [bankDetailId], references: [id])

  createdById String
  createdBy   User   @relation("QuoteCreator", fields: [createdById], references: [id])

  documentRequests DocumentRequest[]
  reports          Report[]
  projects         Project[]
}

model Report {
  id           String   @id @default(cuid())
  publicToken  String   @unique
  title        String
  message      String?
  originalName String
  storedName   String
  mimeType     String?
  size         Int      @default(0)
  status       String   @default("READY")
  sharedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quoteId      String
  quote        Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User   @relation("ReportUploader", fields: [uploadedById], references: [id])
}

model DocumentRequest {
  id                String   @id @default(cuid())
  publicToken       String   @unique
  status            String   @default("SHARED")
  teamRemark        String?
  questionnaire     String?
  customerFinalNote String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quoteId String
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  createdById String
  createdBy   User @relation("DocRequestCreator", fields: [createdById], references: [id])

  uploads CustomerDocumentUpload[]
}

model CustomerDocumentUpload {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String?
  size         Int      @default(0)
  remark       String?
  createdAt    DateTime @default(now())

  requestId String
  request   DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  libraryItemId String?
  libraryItem   DocumentLibraryItem? @relation(fields: [libraryItemId], references: [id])
}

model TestingService {
  id            String   @id @default(cuid())
  name          String
  labName       String
  purchasePrice Float
  salesPrice    Float
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
