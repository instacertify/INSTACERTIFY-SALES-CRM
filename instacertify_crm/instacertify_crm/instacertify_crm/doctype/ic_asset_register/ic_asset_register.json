 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "IC-AST-.YYYY.-",
   "default": "IC-AST-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "asset_code",
   "label": "Asset Code",
   "fieldtype": "Data",
   "unique": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "asset_name",
   "label": "Asset Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "category",
   "label": "Category",
   "fieldtype": "Select",
   "options": "\nLaptop\nPhone\nLab Equipment\nFurniture\nVehicle\nSoftware\nOther",
   "default": "Other"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "\nAvailable\nAssigned\nUnder Repair\nRetired\nLost",
   "default": "Available",
   "in_list_view": 1
  },
  {
   "fieldname": "section_value",
   "label": "Value & Custody",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "purchase_value",
   "label": "Asset Value",
   "fieldtype": "Currency",
   "in_list_view": 1
  },
  {
   "fieldname": "purchase_date",
   "label": "Acquired On",
   "fieldtype": "Date"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "custodian",
   "label": "Who Has The Asset",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1
  },
  {
   "fieldname": "location",
   "label": "Location",
   "fieldtype": "Data"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "attachment",
   "label": "Invoice / Photo",
   "fieldtype": "Attach"
  }
 ]
