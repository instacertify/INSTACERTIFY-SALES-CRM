   "fieldname": "sample_requirements_html",
   "label": "Sample Required Content",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "section_commercials",
   "label": "4. Commercials",
   "fieldtype": "Section Break",
   "collapsible": 1,
   "collapsible_depends_on": "eval:doc.quote_type=='Testing'",
   "description": "Customers only see selling / total charges \u2014 never purchase price."
  },
  {
   "fieldname": "commercials_header",
   "label": "Section Header",
   "fieldtype": "Data",
   "default": "Commercials"
  },
  {
   "fieldname": "testing_items",
   "label": "Testing Line Items",
   "fieldtype": "Table",
   "options": "IC Quote Testing Item",
   "depends_on": "eval:doc.quote_type=='Testing'"
