{
 "doctype": "DocType",
 "name": "IC Quote",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "naming_series",
  "quote_number",
  "quote_type",
  "public_token",
  "status",
  "column_break_1",
  "lead",
  "template",
  "subject",
  "validity_date",
  "section_customer",
  "customer_name",
  "company",
  "email",
  "column_break_2",
  "phone",
  "country",
  "state",
  "section_service",
  "service",
  "description",
  "about_html",
  "standards_html",
  "accreditation_html",
  "sample_requirements_html",
  "section_testing",
  "testing_items",
  "section_commercials",
  "consulting_price",
  "testing_price",
  "other_commercials",
  "column_break_3",
  "other_commercials_note",
  "total_revenue",
  "section_terms",
  "deliverables_html",
  "timeline_html",
  "payment_terms_html",
  "sample_handling_html",
  "policies_html",
  "body_html",
  "section_bank",
  "bank_detail",
  "bank_snapshot",
  "section_customer_response",
  "customer_remark",
  "revision_message",
  "shared_on",
  "accepted_on",
  "public_url"
 ],
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "quote_number",
 "search_fields": "quote_number,customer_name,company,status,service,quote_type,subject",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "ICQ-.YYYY.-",
   "default": "ICQ-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "quote_number",
   "label": "Quote Number",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "quote_type",
   "label": "Quote For",
   "fieldtype": "Select",
   "options": "Testing\nService",
   "default": "Testing",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Choose Testing or Service business before preparing the customer quotation."
  },
  {
   "fieldname": "public_token",
   "label": "Public Token",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Draft\nShared\nRevision Requested\nAccepted\nSuperseded",
   "default": "Draft",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lead",
   "label": "Lead",
   "fieldtype": "Link",
   "options": "IC Lead"
  },
  {
   "fieldname": "template",
   "label": "Template",
   "fieldtype": "Link",
   "options": "IC Quote Template",
   "description": "Filtered by Quote For (Testing / Service)."
  },
  {
   "fieldname": "subject",
   "label": "Subject",
   "fieldtype": "Data",
   "in_list_view": 1
  },
  {
   "fieldname": "validity_date",
   "label": "Validity Date",
   "fieldtype": "Date",
   "reqd": 1
  },
  {
   "fieldname": "section_customer",
   "label": "Customer",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer_name",
   "label": "Customer Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email",
   "reqd": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country",
   "default": "India",
   "reqd": 1
  },
  {
   "fieldname": "state",
   "label": "State",
   "fieldtype": "Data"
  },
  {
   "fieldname": "section_service",
   "label": "Scope",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "service",
   "label": "Service / Testing Category",
   "fieldtype": "Link",
   "options": "IC Service",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "label": "Short Description",
   "fieldtype": "Small Text",
   "reqd": 1
  },
  {
   "fieldname": "about_html",
   "label": "About",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "standards_html",
   "label": "Applicable Standards",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "accreditation_html",
   "label": "Accreditation",
   "fieldtype": "Text Editor",
   "depends_on": "eval:doc.quote_type=='Service'"
  },
  {
   "fieldname": "sample_requirements_html",
   "label": "Sample Requirements",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "section_testing",
   "label": "Commercial Line Items",
   "fieldtype": "Section Break",
   "depends_on": "eval:doc.quote_type=='Testing'",
   "description": "Customers only see selling / total charges — never purchase price."
  },
  {
   "fieldname": "testing_items",
   "label": "Testing Items",
   "fieldtype": "Table",
   "options": "IC Quote Testing Item",
   "depends_on": "eval:doc.quote_type=='Testing'"
  },
  {
   "fieldname": "section_commercials",
   "label": "Commercial Summary",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "consulting_price",
   "label": "Commercial Consulting Price",
   "fieldtype": "Currency",
   "default": "0",
   "depends_on": "eval:doc.quote_type=='Service'"
  },
  {
   "fieldname": "testing_price",
   "label": "Testing / Service Charges",
   "fieldtype": "Currency",
   "default": "0"
  },
  {
   "fieldname": "other_commercials",
   "label": "Other Commercials",
   "fieldtype": "Currency",
   "default": "0",
   "description": "Included in revenue"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "other_commercials_note",
   "label": "Other Commercials Note",
   "fieldtype": "Data"
  },
  {
   "fieldname": "total_revenue",
   "label": "Total Revenue",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "section_terms",
   "label": "Deliverables & Terms",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "deliverables_html",
   "label": "Deliverables",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "timeline_html",
   "label": "Timeline",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "payment_terms_html",
   "label": "Payment Terms",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "sample_handling_html",
   "label": "Sample Handling & Disposal",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "policies_html",
   "label": "Policies",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "body_html",
   "label": "Extra Letter Body",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "section_bank",
   "label": "Banking Details",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "bank_detail",
   "label": "Bank Profile",
   "fieldtype": "Link",
   "options": "IC Bank Detail"
  },
  {
   "fieldname": "bank_snapshot",
   "label": "Banking Text on Quote",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "section_customer_response",
   "label": "Customer Response",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer_remark",
   "label": "Customer Remark",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "revision_message",
   "label": "Revision Message",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "shared_on",
   "label": "Shared On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "accepted_on",
   "label": "Accepted On",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "public_url",
   "label": "Public URL",
   "fieldtype": "Small Text",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ]
}
