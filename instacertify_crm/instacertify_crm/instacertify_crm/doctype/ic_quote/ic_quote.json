 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "quote_number",
 "search_fields": "quote_number,customer_name,company,status,service,quote_type,subject",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "ICQ-.YYYY.-",
   "default": "ICQ-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "quote_number",
   "label": "Quote Number",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "quote_type",
   "label": "Quote For",
   "fieldtype": "Select",
   "options": "Testing\nService",
   "default": "Testing",
   "reqd": 1,
   "in_list_view": 1,
   "description": "For Testing quotes, use the collapsible sections below with customisable headers."
  },
  {
   "fieldname": "public_token",
   "label": "Public Token",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Draft\nShared\nRevision Requested\nAccepted\nDelivered\nSuperseded",
   "default": "Draft",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lead",
   "label": "Lead",
   "fieldtype": "Link",
   "options": "IC Lead"
  },
  {
   "fieldname": "template",
   "label": "Template",
   "fieldtype": "Link",
   "options": "IC Quote Template",
   "description": "Filtered by Quote For (Testing / Service)."
  },
  {
   "fieldname": "subject",
   "label": "Subject",
   "fieldtype": "Data",
   "in_list_view": 1
  },
  {
   "fieldname": "validity_date",
   "label": "Validity Date",
   "fieldtype": "Date",
   "reqd": 1
  },
  {
   "fieldname": "section_customer",
   "label": "Customer",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer_name",
   "label": "Customer Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email",
   "reqd": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country",
   "default": "India",
   "reqd": 1
  },
  {
   "fieldname": "state",
   "label": "State",
   "fieldtype": "Data"
  },
  {
   "fieldname": "section_service",
   "label": "Scope",
   "fieldtype": "Section Break"
