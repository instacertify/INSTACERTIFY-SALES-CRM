{
 "doctype": "DocType",
 "name": "IC Document Request",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "quote",
  "service",
  "status",
  "column_break_1",
  "public_token",
  "public_url",
  "section_docs",
  "requested_documents",
  "section_notes",
  "questionnaire",
  "team_remark",
  "customer_final_note",
  "section_uploads",
  "uploads"
 ],
 "autoname": "format:DOC-{####}",
 "title_field": "quote",
 "fields": [
  {
   "fieldname": "quote",
   "label": "Quote",
   "fieldtype": "Link",
   "options": "IC Quote",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "service",
   "label": "Service",
   "fieldtype": "Link",
   "options": "IC Service",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Shared\nUploaded\nFinal\nNeeds More",
   "default": "Shared",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "public_token",
   "label": "Public Token",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "public_url",
   "label": "Customer Link",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "section_docs",
   "label": "Documents Selected for Customer",
   "fieldtype": "Section Break",
   "description": "Pick only the documents the customer should upload for this accepted quote."
  },
  {
   "fieldname": "requested_documents",
   "label": "Requested Documents",
   "fieldtype": "Table",
   "options": "IC Document Request Item",
   "reqd": 1
  },
  {
   "fieldname": "section_notes",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "questionnaire",
   "label": "Questionnaire / Remarks",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "team_remark",
   "label": "Team Remark to Customer",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "customer_final_note",
   "label": "Customer Final Note",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "section_uploads",
   "label": "Uploads",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "uploads",
   "label": "Uploads",
   "fieldtype": "Table",
   "options": "IC Customer Upload"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC All Ops Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Operations Manager",
   "read": 1,
