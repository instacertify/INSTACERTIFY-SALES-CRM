{
 "doctype": "DocType",
 "name": "IC Lab",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "field:lab_name",
 "naming_rule": "By fieldname",
 "title_field": "lab_name",
 "search_fields": "lab_name,city,state,country,accreditation_number,primary_contact",
 "field_order": [
  "lab_name",
  "active",
  "accreditation_body",
  "column_break_1",
  "accreditation_number",
  "accreditation_valid_upto",
  "website",
  "section_location",
  "address_line",
  "city",
  "column_break_2",
  "state",
  "country",
  "pincode",
  "location_notes",
  "section_contacts",
  "primary_contact",
  "primary_email",
  "primary_phone",
  "contacts",
  "section_scope",
  "scope",
  "section_certificates",
  "accreditation_certificate",
  "other_certificate",
  "section_notes",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "lab_name",
   "label": "Lab Name",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "active",
   "label": "Active",
   "fieldtype": "Check",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "accreditation_body",
   "label": "Accreditation Body",
   "fieldtype": "Data",
   "default": "NABL / ISO/IEC 17025",
   "in_list_view": 1,
   "description": "e.g. NABL, BIS-recognized, ILAC MRA partner"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "accreditation_number",
   "label": "Accreditation / Certificate No.",
   "fieldtype": "Data",
   "in_standard_filter": 1
  },
  {
   "fieldname": "accreditation_valid_upto",
   "label": "Accreditation Valid Upto",
   "fieldtype": "Date"
  },
  {
   "fieldname": "website",
   "label": "Website",
   "fieldtype": "Data",
   "options": "URL"
  },
  {
   "fieldname": "section_location",
   "label": "Lab Location",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "address_line",
   "label": "Address",
   "fieldtype": "Small Text",
   "reqd": 1
  },
  {
   "fieldname": "city",
   "label": "City",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "state",
   "label": "State",
   "fieldtype": "Data",
   "in_standard_filter": 1
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country",
   "default": "India",
   "reqd": 1
  },
  {
   "fieldname": "pincode",
   "label": "PIN / ZIP",
   "fieldtype": "Data"
  },
  {
   "fieldname": "location_notes",
   "label": "Location Notes",
   "fieldtype": "Small Text",
   "description": "Landmark, campus, collection centre details"
  },
  {
   "fieldname": "section_contacts",
   "label": "Contact Persons",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "primary_contact",
   "label": "Primary Contact",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "primary_email",
   "label": "Primary Email",
   "fieldtype": "Data",
   "options": "Email",
   "read_only": 1
  },
  {
   "fieldname": "primary_phone",
   "label": "Primary Phone",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "contacts",
   "label": "Contacts",
   "fieldtype": "Table",
   "options": "IC Lab Contact",
   "reqd": 1,
   "description": "Add all lab contact persons. Mark one as Primary."
  },
  {
   "fieldname": "section_scope",
   "label": "Accreditation Scope",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "scope",
   "label": "Scope of Accreditation",
   "fieldtype": "Text Editor",
   "reqd": 1,
   "description": "Tests / products / standards covered by this lab"
  },
  {
   "fieldname": "section_certificates",
   "label": "Certificates",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "accreditation_certificate",
   "label": "Accreditation Certificate",
   "fieldtype": "Attach",
   "description": "Upload NABL / ISO 17025 / recognition certificate PDF or image"
  },
  {
   "fieldname": "other_certificate",
   "label": "Other Certificate / Annexure",
   "fieldtype": "Attach",
   "description": "Scope annexure, BIS recognition letter, etc."
  },
  {
   "fieldname": "section_notes",
   "label": "Internal Notes",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
