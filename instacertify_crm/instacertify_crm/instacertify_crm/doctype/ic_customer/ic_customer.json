{
 "doctype": "DocType",
 "name": "IC Customer",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "company",
 "search_fields": "company,customer_name,email,phone,status",
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "naming_series",
  "company",
  "customer_name",
  "status",
  "column_break_1",
  "email",
  "phone",
  "country",
  "state",
  "section_metrics",
  "active_projects",
  "total_projects",
  "total_quotes",
  "column_break_2",
  "lifetime_value",
  "won_value",
  "last_activity_on",
  "section_links",
  "primary_lead",
  "section_notes",
  "notes",
  "section_dashboard",
  "dashboard_html"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "IC-CUST-.YYYY.-",
   "default": "IC-CUST-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "customer_name",
   "label": "Contact Person",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Active\nInactive",
   "default": "Active",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data",
   "in_list_view": 1
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country",
   "default": "India"
  },
  {
   "fieldname": "state",
   "label": "State",
   "fieldtype": "Data"
  },
  {
   "fieldname": "section_metrics",
   "label": "Customer Snapshot",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "active_projects",
   "label": "Active Projects",
   "fieldtype": "Int",
   "read_only": 1,
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "total_projects",
   "label": "Total Projects",
   "fieldtype": "Int",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "total_quotes",
   "label": "Total Quotes",
   "fieldtype": "Int",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lifetime_value",
   "label": "Lifetime Value",
   "fieldtype": "Currency",
   "read_only": 1,
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "won_value",
   "label": "Won / Accepted Value",
   "fieldtype": "Currency",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "last_activity_on",
   "label": "Last Activity",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "section_links",
   "label": "Links",
   "fieldtype": "Section Break",
   "collapsible": 1
  },
  {
   "fieldname": "primary_lead",
   "label": "Primary Lead",
   "fieldtype": "Link",
   "options": "IC Lead"
  },
  {
   "fieldname": "section_notes",
   "label": "Notes",
   "fieldtype": "Section Break",
   "collapsible": 1
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "section_dashboard",
   "label": "Customer Charts",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "dashboard_html",
   "label": "Dashboard",
   "fieldtype": "HTML"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ]
}
