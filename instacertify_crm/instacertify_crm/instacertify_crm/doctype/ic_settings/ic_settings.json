{
 "doctype": "DocType",
 "name": "IC Settings",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "issingle": 1,
 "is_submittable": 0,
 "istable": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "section_brand",
  "brand_name",
  "legal_name",
  "tagline",
  "column_break_1",
  "apply_logo_sitewide",
  "apply_letter_head",
  "section_logos",
  "company_logo",
  "letterhead_logo",
  "favicon",
  "section_contact",
  "phone",
  "email",
  "website",
  "column_break_2",
  "address_line",
  "cin",
  "section_costs",
  "default_lead_cost",
  "section_help",
  "help_html"
 ],
 "fields": [
  {
   "fieldname": "section_brand",
   "label": "Brand",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "brand_name",
   "label": "Brand Name",
   "fieldtype": "Data",
   "default": "Instacertify",
   "reqd": 1
  },
  {
   "fieldname": "legal_name",
   "label": "Legal Name",
   "fieldtype": "Data",
   "default": "Instacertify Labs Pvt Ltd"
  },
  {
   "fieldname": "tagline",
   "label": "Tagline",
   "fieldtype": "Data",
   "default": "certifications made simple"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "apply_logo_sitewide",
   "label": "Apply logo across website / portals",
   "fieldtype": "Check",
   "default": "1",
   "description": "Updates Website Settings banner/logo when saved."
  },
  {
   "fieldname": "apply_letter_head",
   "label": "Sync Letter Head for quotes/prints",
   "fieldtype": "Check",
   "default": "1",
   "description": "Creates/updates the Instacertify Letter Head used on print formats."
  },
  {
   "fieldname": "section_logos",
   "label": "Logos",
   "fieldtype": "Section Break",
   "description": "Upload once — used on quote letterhead, customer portals, and (optionally) site branding."
  },
  {
   "fieldname": "company_logo",
   "label": "Company Logo",
   "fieldtype": "Attach Image",
   "reqd": 0
  },
  {
   "fieldname": "letterhead_logo",
   "label": "Letterhead Logo",
   "fieldtype": "Attach Image",
   "description": "Optional. Falls back to Company Logo on quotes if empty."
  },
  {
   "fieldname": "favicon",
   "label": "Favicon",
   "fieldtype": "Attach Image"
  },
  {
   "fieldname": "section_contact",
   "label": "Letterhead Contact Footer",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data",
   "default": "+91 9999118039"
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email",
   "default": "contact@instacertify.com"
  },
  {
   "fieldname": "website",
   "label": "Website",
   "fieldtype": "Data",
   "default": "www.instacertify.com"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "address_line",
   "label": "Address",
   "fieldtype": "Small Text",
   "default": "PK 1 Sector 63 A Noida, Uttar Pradesh, India - 201301"
  },
  {
   "fieldname": "cin",
   "label": "CIN",
   "fieldtype": "Data",
   "default": "UP74999UP2022PTC170291"
  },
  {
   "fieldname": "section_costs",
   "label": "Lead Cost Defaults",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "default_lead_cost",
   "label": "Default Lead Cost (INR)",
   "fieldtype": "Currency",
   "default": "800",
   "description": "Applied to new leads when Lead Cost is blank. Admins track total spend in Lead Cost Spend report."
  },
  {
   "fieldname": "section_help",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "help_html",
   "label": "How it works",
   "fieldtype": "HTML",
   "options": "<p>Upload <b>Company Logo</b> (and optional <b>Letterhead Logo</b>). Saving applies branding to:</p><ul><li>Quote print letterhead</li><li>Public quote / document / report pages</li><li>Website Settings (if enabled)</li><li>Frappe Letter Head “Instacertify” (if enabled)</li></ul><p>Set <b>Default Lead Cost</b> (₹800 by default). Edit per lead anytime; admins open <b>Lead Cost Spend</b> for totals.</p>"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "print": 1
  }
 ]
}
