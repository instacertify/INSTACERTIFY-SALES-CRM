{
 "doctype": "DocType",
 "name": "IC Customer Project",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "format:PRJ-{YYYY}-{#####}",
 "title_field": "project_title",
 "search_fields": "project_title,customer_name,company,status,service,lead",
 "field_order": [
  "project_title",
  "status",
  "service",
  "column_break_1",
  "lead",
  "primary_quote",
  "assigned_to",
  "last_activity_on",
  "section_customer",
  "customer_name",
  "company",
  "email",
  "column_break_2",
  "phone",
  "country",
  "state",
  "section_scope",
  "scope_summary",
  "section_remarks",
  "remarks"
 ],
 "fields": [
  {
   "fieldname": "project_title",
   "label": "Project Title",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "label": "Lifecycle Status",
   "fieldtype": "Select",
   "options": "Open\nQuoted\nAccepted\nDocuments Pending\nIn Delivery\nDelivered\nClosed\nLost",
   "default": "Open",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "service",
   "label": "Service",
   "fieldtype": "Link",
   "options": "IC Service",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lead",
   "label": "Lead",
   "fieldtype": "Link",
   "options": "IC Lead",
   "in_standard_filter": 1
  },
  {
   "fieldname": "primary_quote",
   "label": "Primary Quote",
   "fieldtype": "Link",
   "options": "IC Quote"
  },
  {
   "fieldname": "assigned_to",
   "label": "Assigned To",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Any team member can assign this project to others. IC Admin can always reassign."
  },
  {
   "fieldname": "last_activity_on",
   "label": "Last Activity",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "section_customer",
   "label": "Customer",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer_name",
   "label": "Customer Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email",
   "reqd": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country",
   "default": "India"
  },
  {
   "fieldname": "state",
   "label": "State",
   "fieldtype": "Data"
  },
  {
   "fieldname": "section_scope",
   "label": "Project Scope",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "scope_summary",
   "label": "Scope / Project Details",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "section_remarks",
   "label": "Project Remarks Timeline",
   "fieldtype": "Section Break",
   "description": "Track remarks across quote, documents, delivery and reports."
  },
  {
   "fieldname": "remarks",
   "label": "Remarks",
   "fieldtype": "Table",
   "options": "IC Project Remark"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ]
}
