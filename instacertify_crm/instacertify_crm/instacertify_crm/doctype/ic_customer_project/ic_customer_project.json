{
 "doctype": "DocType",
 "name": "IC Customer Project",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "format:PRJ-{YYYY}-{#####}",
 "title_field": "project_title",
 "search_fields": "project_title,customer_name,company,status,service,lead,commercial_owner,delivery_owner",
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "project_title",
  "status",
  "service",
  "column_break_1",
  "lead",
  "primary_quote",
  "project_value",
  "start_date",
  "expected_completion",
  "section_owners",
  "commercial_owner",
  "delivery_owner",
  "column_break_owners",
  "assigned_to",
  "last_activity_on",
  "section_waiting",
  "waiting_for",
  "waiting_expected_on",
  "waiting_note",
  "section_customer",
  "customer_name",
  "company",
  "email",
  "column_break_2",
  "phone",
  "country",
  "state",
  "section_scope",
  "scope_summary",
  "section_remarks",
  "remarks"
 ],
 "fields": [
  {
   "fieldname": "project_title",
   "label": "Project Title",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "label": "Project Status",
   "fieldtype": "Select",
   "options": "Not Started\nQuoted\nAccepted\nDocuments Pending\nDocuments Complete\nTesting\nApplication/Certification\nAuthority/Lab Pending\nClient Action Required\nCompleted\nClosed\nLost",
   "default": "Not Started",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Service-specific workflows can skip stages. Use Waiting For when blocked externally."
  },
  {
   "fieldname": "service",
   "label": "Service",
   "fieldtype": "Link",
   "options": "IC Service",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lead",
   "label": "Lead",
   "fieldtype": "Link",
   "options": "IC Lead",
   "in_standard_filter": 1
  },
  {
   "fieldname": "primary_quote",
   "label": "Primary Quote",
   "fieldtype": "Link",
   "options": "IC Quote"
  },
  {
   "fieldname": "project_value",
   "label": "Project Value",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "description": "Usually copied from the accepted quotation total."
  },
  {
   "fieldname": "start_date",
   "label": "Start Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "expected_completion",
   "label": "Expected Completion",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "fieldname": "section_owners",
   "label": "Ownership",
   "fieldtype": "Section Break",
   "description": "Commercial Owner sold the work. Delivery Owner executes it. They may be the same person."
  },
  {
   "fieldname": "commercial_owner",
   "label": "Commercial Owner",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Who brought / sold the business"
  },
  {
   "fieldname": "delivery_owner",
   "label": "Delivery Owner",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Who is responsible for executing delivery"
  },
  {
   "fieldname": "column_break_owners",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "assigned_to",
   "label": "Assigned To (legacy)",
   "fieldtype": "Link",
   "options": "User",
   "in_standard_filter": 1,
   "description": "Kept in sync with Delivery Owner for older reports and assignments."
  },
  {
   "fieldname": "last_activity_on",
   "label": "Last Activity",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "section_waiting",
   "label": "Waiting / Blockers",
   "fieldtype": "Section Break",
   "collapsible": 1
  },
  {
   "fieldname": "waiting_for",
   "label": "Waiting For",
   "fieldtype": "Select",
   "options": "\nClient\nLab\nGovernment\nPayment\nSample\nInternal\nOther",
   "in_standard_filter": 1
  },
  {
   "fieldname": "waiting_expected_on",
   "label": "Waiting Expected Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "waiting_note",
   "label": "Waiting Note",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "section_customer",
   "label": "Customer",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer_name",
   "label": "Customer Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email",
   "reqd": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Link",
   "options": "Country",
   "default": "India"
  },
  {
   "fieldname": "state",
   "label": "State",
   "fieldtype": "Data"
  },
  {
   "fieldname": "section_scope",
   "label": "Project Scope",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "scope_summary",
   "label": "Scope / Project Details",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "section_remarks",
   "label": "Communication Timeline",
   "fieldtype": "Section Break",
   "description": "Record important client / lab / government updates. This is the shared project timeline."
  },
  {
   "fieldname": "remarks",
   "label": "Timeline",
   "fieldtype": "Table",
   "options": "IC Project Remark"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ]
}
