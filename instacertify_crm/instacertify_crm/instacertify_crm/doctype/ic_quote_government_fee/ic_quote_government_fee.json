{
 "doctype": "DocType",
 "name": "IC Quote Government Fee",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "istable": 1,
 "editable_grid": 1,
 "track_changes": 1,
 "field_order": [
  "fee_type",
  "description",
  "amount",
  "payable_to",
  "counts_as_revenue"
 ],
 "permissions": [],
 "fields": [
  {
   "fieldname": "fee_type",
   "label": "Government Fee Type",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "description": "e.g. BIS application fee, marking fee, audit fee"
  },
  {
   "fieldname": "description",
   "label": "Description",
   "fieldtype": "Small Text",
   "in_list_view": 1
  },
  {
   "fieldname": "amount",
   "label": "Amount",
   "fieldtype": "Currency",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payable_to",
   "label": "Payable To",
   "fieldtype": "Select",
   "options": "Instacertify\nGovernment Portal\nLab Direct",
   "default": "Government Portal",
   "in_list_view": 1,
   "description": "Where the customer pays this fee"
  },
  {
   "fieldname": "counts_as_revenue",
   "label": "Our Revenue",
   "fieldtype": "Check",
   "default": 0,
   "in_list_view": 1,
   "description": "Government fees are usually not Instacertify revenue"
  }
 ]
}
