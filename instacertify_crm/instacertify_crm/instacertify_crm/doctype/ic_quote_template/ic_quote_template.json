{
 "doctype": "DocType",
 "name": "IC Quote Template",
 "module": "Instacertify CRM",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "template_name",
  "quote_type",
  "service",
  "subject",
  "column_break_1",
  "validity_days",
  "consulting_price",
  "testing_price",
  "other_commercials",
  "other_commercials_note",
  "section_body",
  "about_html",
  "standards_html",
  "accreditation_html",
  "sample_requirements_html",
  "deliverables_html",
  "timeline_html",
  "payment_terms_html",
  "sample_handling_html",
  "policies_html",
  "body_html",
  "section_bank",
  "bank_detail"
 ],
 "autoname": "field:template_name",
 "naming_rule": "By fieldname",
 "title_field": "template_name",
 "search_fields": "template_name,quote_type,service,subject",
 "fields": [
  {
   "fieldname": "template_name",
   "label": "Template Name",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "quote_type",
   "label": "Quote Type",
   "fieldtype": "Select",
   "options": "Testing\nService",
   "default": "Testing",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "service",
   "label": "Default Service",
   "fieldtype": "Link",
   "options": "IC Service"
  },
  {
   "fieldname": "subject",
   "label": "Subject",
   "fieldtype": "Data",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "validity_days",
   "label": "Validity Days",
   "fieldtype": "Int",
   "default": "30"
  },
  {
   "fieldname": "consulting_price",
   "label": "Consulting Price",
   "fieldtype": "Currency",
   "default": "0"
  },
  {
   "fieldname": "testing_price",
   "label": "Testing Price",
   "fieldtype": "Currency",
   "default": "0"
  },
  {
   "fieldname": "other_commercials",
   "label": "Other Commercials",
   "fieldtype": "Currency",
   "default": "0"
  },
  {
   "fieldname": "other_commercials_note",
   "label": "Other Commercials Note",
   "fieldtype": "Data"
  },
  {
   "fieldname": "section_body",
   "label": "Letter Sections",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "about_html",
   "label": "About",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "standards_html",
   "label": "Applicable Standards",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "accreditation_html",
   "label": "Accreditation",
   "fieldtype": "Text Editor",
   "depends_on": "eval:doc.quote_type=='Service'"
  },
  {
   "fieldname": "sample_requirements_html",
   "label": "Sample Requirements",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "deliverables_html",
   "label": "Deliverables",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "timeline_html",
   "label": "Timeline",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "payment_terms_html",
   "label": "Payment Terms",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "sample_handling_html",
   "label": "Sample Handling & Disposal",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "policies_html",
   "label": "Policies (Cancellation / Force Majeure / Confidentiality)",
   "fieldtype": "Text Editor"
  },
  {
   "fieldname": "body_html",
   "label": "Extra Letter Body",
   "fieldtype": "Text Editor",
   "description": "Optional free-form content appended after the structured sections."
  },
  {
   "fieldname": "section_bank",
   "label": "Banking (Admin only edit)",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "bank_detail",
   "label": "Bank Detail",
   "fieldtype": "Link",
   "options": "IC Bank Detail"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "role": "IC Sales Ops",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ]
}
